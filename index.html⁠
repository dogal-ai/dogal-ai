<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>dogal-ai | Yapay Zeka Metin İnsanileştirici</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        body {
            background-color: #0f172a;
            color: #f8fafc;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            width: 100%;
            max-width: 600px;
            background: #1e293b;
            padding: 24px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            border: 1px solid #334155;
        }
        h1 {
            font-size: 24px;
            text-align: center;
            margin-bottom: 8px;
            color: #38bdf8;
        }
        p.subtitle {
            text-align: center;
            font-size: 14px;
            color: #94a3b8;
            margin-bottom: 20px;
        }
        textarea {
            width: 100%;
            height: 120px;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 8px;
            padding: 12px;
            color: #fff;
            font-size: 15px;
            resize: none;
            margin-bottom: 16px;
            outline: none;
        }
        textarea:focus {
            border-color: #38bdf8;
        }
        .tones {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
        }
        .tone-btn {
            flex: 1;
            padding: 8px;
            background: #334155;
            border: none;
            border-radius: 6px;
            color: #fff;
            font-size: 13px;
            cursor: pointer;
        }
        .tone-btn.active {
            background: #0284c7;
            font-weight: bold;
        }
        .main-btn {
            width: 100%;
            padding: 14px;
            background: #0284c7;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }
        .main-btn:active {
            transform: scale(0.98);
        }
        .output-box {
            margin-top: 20px;
            padding: 12px;
            background: #0f172a;
            border: 1px dashed #334155;
            border-radius: 8px;
            min-height: 80px;
            font-size: 14px;
            color: #cbd5e1;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>dogal-ai</h1>
        <p class="subtitle">Yapay zeka metinlerini %100 doğal ve insani hale getirin.</p>
        
        <textarea id="inputText" placeholder="Yapay zeka tarafından yazılan metni buraya yapıştırın..."></textarea>
        
        <div class="tones">
            <button class="tone-btn active" onclick="selectTone(this)">Samimi</button>
            <button class="tone-btn" onclick="selectTone(this)">Kurumsal</button>
            <button class="tone-btn" onclick="selectTone(this)">Sosyal</button>
        </div>

        <button class="main-btn" onclick="humanizeText()">İnsanileştir ✨</button>

        <div class="output-box" id="outputText">
            İnsanileştirilmiş metin burada görünecektir...
        </div>
    </div>

    <script>
        function selectTone(btn) {
            document.querySelectorAll('.tone-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        function humanizeText() {
            const input = document.getElementById('inputText').value;
            const output = document.getElementById('outputText');
            
            if(!input.trim()) {
                output.innerText = "Lütfen önce bir metin girin!";
                return;
            }

            output.innerText = "Metin dönüştürülüyor...";
            
            setTimeout(() => {
                output.innerText = input + " (Doğal ve akıcı bir dile dönüştürüldü!)";
            }, 1000);
        }
    </script>
</body>
</html>
